// dqiv.v.cg -- the one vertex program of the CG ops (04_SHADERS §4): gl_Position = mvp * v, uv = uv0 * ST.xy + ST.zw, colour = vertexColor * tint.
// mvp is passed as 4 row vectors (no matrix uniform: keeps the serialized vitaGL blob trivial). Clip-space shaders (Sepia) load an identity mvp.
void main(float3 position,
          float2 texcoord,
          float4 color,
          uniform float4 mvp0, uniform float4 mvp1, uniform float4 mvp2, uniform float4 mvp3,
          uniform float4 st,
          uniform float4 tint,
          float4 out gl_Position : POSITION,
          float2 out vTex : TEXCOORD0,
          float4 out vColor : COLOR0)
{
  float4 p = float4(position, 1.0);
  gl_Position = float4(dot(mvp0, p), dot(mvp1, p), dot(mvp2, p), dot(mvp3, p));
  vTex = texcoord * st.xy + st.zw;
  vColor = color * tint;
}
